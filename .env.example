# EmailJS (browser — use NEXT_PUBLIC_ prefix so Next.js exposes these to the client)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Cloudflare Turnstile (contact form CAPTCHA) — optional in local dev
# Create a widget at https://dash.cloudflare.com/ → Turnstile
# Site key is public; secret key is server-only (never NEXT_PUBLIC_)
# When unset, the form still submits via EmailJS without CAPTCHA.
# Always-pass test keys (local only):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Site URL (metadata, Sanity preview links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity.io — create a project at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Optional: custom hostname when deploying standalone Studio (sanity deploy)
# SANITY_STUDIO_HOSTNAME=

# Optional: write token for npm run seed:sanity (server-only — never NEXT_PUBLIC_)
# Create at https://www.sanity.io/manage → API → Tokens (Editor). Put in .env or .env.local.
SANITY_API_WRITE_TOKEN=

# Google Gemini (server-only — never NEXT_PUBLIC_)
# Used by POST /api/translate for EN→TR content translation in Sanity Studio.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash


