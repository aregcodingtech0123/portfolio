# EmailJS (browser — use NEXT_PUBLIC_ prefix so Next.js exposes these to the client)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Site URL (metadata, Sanity preview links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity.io — create a project at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Optional: custom hostname when deploying standalone Studio (sanity deploy)
# SANITY_STUDIO_HOSTNAME=

# Optional: write token for npm run seed:sanity (server-only — never NEXT_PUBLIC_)
# Create at https://www.sanity.io/manage → API → Tokens (Editor). Put in .env or .env.local.
SANITY_API_WRITE_TOKEN=
