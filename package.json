{
  "name": "mypersonalwebsite",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && node scripts/check-copy.mjs && node scripts/check-i18n.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sanity:types": "sanity schema extract && sanity typegen generate",
    "seed:sanity": "tsx scripts/seed-sanity.ts",
    "icons": "tsx scripts/icons/generate-icons.ts",
    "og:image": "tsx scripts/og/generate-og-image.ts",
    "check:copy": "node scripts/check-copy.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "perf": "node scripts/perf/lighthouse.mjs",
    "perf:observe": "node scripts/perf/observe.mjs",
    "perf:bundle": "node scripts/perf/bundle.mjs",
    "perf:inspect": "node scripts/perf/inspect.mjs",
    "perf:budget": "node scripts/perf/budget.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@marsidev/react-turnstile": "^1.6.1",
    "@sanity/icons": "^5.2.3",
    "@sanity/image-url": "^2.1.1",
    "@sanity/ui": "^4.4.0",
    "@sanity/vision": "^6.18.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.16.0",
    "next": "16.3.8",
    "next-intl": "^4.11.1",
    "next-sanity": "^13.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "sanity": "^6.18.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.5.0",
    "puppeteer-core": "^25.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
